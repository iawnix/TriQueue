[Unit]
Description=tri compute client on WORKER
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=triuser
Group=triuser
Environment=TRI_SERVER_ADDR=192.0.2.10:7400
ExecStart=/usr/local/bin/tri-client --name worker --address 192.0.2.11 --cpus 8 --memory 16G --gpus 0 --scratch /var/tmp/tri-scratch
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
